# OKX API credentials. Keep real values only in .env, never in HTML or git.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# OKX region/domain:
#   default: https://www.okx.com
#   US/AU accounts may need https://us.okx.com
#   EU accounts may need https://eea.okx.com
OKX_BASE_URL=https://www.okx.com

# 1 = OKX demo trading header, 0 = production.
OKX_SIMULATED=1

# Extra guard. Real orders require --live plus OKX_ALLOW_LIVE=1 plus confirm text.
OKX_ALLOW_LIVE=0

# Strategy execution caps.
OKX_MAX_ORDER_USDT=100
OKX_DEFAULT_ORDER_USDT=50

# Bybit V5 spot. Testnet is enabled by default.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=1
BYBIT_BASE_URL=https://api-testnet.bybit.com
BYBIT_ALLOW_LIVE=0
BYBIT_DEFAULT_LOT_SZ=0.000001
BYBIT_DEFAULT_MIN_SZ=0.00001

# Gate API v4 spot. No live order is sent unless GATE_ALLOW_LIVE=1 and CLI confirmation is passed.
GATE_API_KEY=
GATE_API_SECRET=
GATE_BASE_URL=https://api.gateio.ws
GATE_ALLOW_LIVE=0
GATE_DEFAULT_LOT_SZ=0.00000001
GATE_DEFAULT_MIN_SZ=0.00001

# Bitget API v2 spot.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com
BITGET_ALLOW_LIVE=0
BITGET_DEFAULT_LOT_SZ=0.00000001
BITGET_DEFAULT_MIN_SZ=0.00001
