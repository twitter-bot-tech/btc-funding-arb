[Unit]
Description=BTC strategy data refresh and backtest loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/btc-funding-arb
User=btcbot
Group=btcbot
ExecStart=/opt/btc-funding-arb/.venv/bin/python -u /opt/btc-funding-arb/refresh_strategy_board.py --loop --source bitget --kline-seconds 900 --backtest-seconds 3600
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
